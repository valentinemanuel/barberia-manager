{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp@latest"]
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      },
      "sqlite": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "mcp-server-sqlite",
          "--with",
          "mcp==1.9.4",
          "--with",
          "pydantic==2.11.7",
          "mcp-server-sqlite",
          "--db-path",
          "backend/barberia.db"
        ],
        "disabled": true
      },
      "github": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        },
        "disabled": true
      }
    }
  }
}
